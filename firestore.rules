rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isKey(v) { return v == null || (v is string && v.matches('^[0-9]{1,3}[sgrb]?$')); }
    function nat(v) { return v is int && v >= 0; }

    // Rangliste: alle lesen, jeder schreibt nur seinen eigenen Eintrag (Dokument-ID = eigene UID)
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','disc','discPeak','rolls','shinies','bestN','bestK','aura','rebirths','at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 18
        && nat(request.resource.data.disc) && request.resource.data.disc <= 520
        && nat(request.resource.data.discPeak) && request.resource.data.discPeak <= 520
        && nat(request.resource.data.rolls) && nat(request.resource.data.shinies)
        && nat(request.resource.data.bestN) && nat(request.resource.data.rebirths)
        && isKey(request.resource.data.bestK) && isKey(request.resource.data.aura)
        && nat(request.resource.data.at);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Live-Feed: alle lesen, jeder hat max. 8 eigene Slots (uid_0 … uid_7), die überschrieben werden
    match /feed/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id.matches(request.auth.uid + '_[0-7]')
        && request.resource.data.keys().hasOnly(['uid','name','k','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 18
        && isKey(request.resource.data.k) && request.resource.data.k != null
        && nat(request.resource.data.at);
    }

    // Cloud-Spielstand: nur der eigene
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json','at'])
        && request.resource.data.json is string && request.resource.data.json.size() < 800000
        && nat(request.resource.data.at);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
